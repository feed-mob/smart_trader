<% content_for :title, "执行任务记录 - SmartTrader" %>

<div class="traders-container">
  <div class="traders-background">
    <div class="traders-background__gradient"></div>
    <div class="traders-background__grid"></div>
  </div>

  <header class="traders-header">
    <div class="traders-header__left">
      <%= link_to traders_path, class: "traders-logo" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      <% end %>
      <h1 class="traders-header__title">执行任务记录</h1>
    </div>
    <div class="traders-header__right">
      <%= link_to "配置建议记录", allocation_decisions_path, class: "btn btn-secondary" %>
    </div>
  </header>

  <main class="traders-main">
    <div class="preview-section">
      <div class="preview-section__header">
        <h2 class="preview-section__title">最近 100 条 Execution Task</h2>
      </div>

      <% if @allocation_tasks.any? %>
        <div class="data-table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>日期</th>
                <th>操盘手</th>
                <th>状态</th>
                <th>现金</th>
                <th>净值</th>
                <th>建议</th>
                <th>查看</th>
              </tr>
            </thead>
            <tbody>
              <% @allocation_tasks.each do |task| %>
                <tr>
                  <td><%= task.run_on %></td>
                  <td><%= link_to task.trader.name, task.trader, class: "text-link" %></td>
                  <td><span class="status-pill status-pill--<%= task.status %>"><%= task.status %></span></td>
                  <td><%= number_to_currency(task.ending_cash, unit: "$", precision: 2) %></td>
                  <td><%= number_to_currency(task.portfolio_value, unit: "$", precision: 2) %></td>
                  <td>
                    <% if task.allocation_decision.present? %>
                      <%= link_to "建议 ##{task.allocation_decision_id}", allocation_decision_path(task.allocation_decision), class: "text-link" %>
                    <% else %>
                      -
                    <% end %>
                  </td>
                  <td><%= link_to "详情", allocation_task_path(task), class: "btn btn-ghost btn-sm" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-state">
          <p>暂无执行任务记录</p>
        </div>
      <% end %>
    </div>
  </main>
</div>
