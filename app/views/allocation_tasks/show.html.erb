<% content_for :title, "Execution Task Details - SmartTrader" %>

<div class="traders-container">
  <div class="traders-background">
    <div class="traders-background__gradient"></div>
    <div class="traders-background__grid"></div>
  </div>

  <header class="traders-header">
    <div class="traders-header__left">
      <%= link_to allocation_tasks_path, class: "traders-logo" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      <% end %>
      <h1 class="traders-header__title">Execution Task Details</h1>
    </div>
    <div class="traders-header__right">
      <%= link_to @allocation_task.trader.name, @allocation_task.trader, class: "btn btn-secondary" %>
      <% if @allocation_task.allocation_decision.present? %>
        <%= link_to "View Recommendation", allocation_decision_path(@allocation_task.allocation_decision), class: "btn btn-secondary" %>
      <% end %>
      <%= link_to "Back to List", allocation_tasks_path, class: "btn btn-ghost" %>
    </div>
  </header>

  <main class="traders-main">
    <div class="preview-section">
      <div class="preview-section__header">
        <h2 class="preview-section__title">Basic Information</h2>
      </div>

      <div class="trader-detail__grid">
        <div class="trader-detail__item">
          <span class="trader-detail__label">Trader</span>
          <span class="trader-detail__value"><%= @allocation_task.trader.name %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">Execution Date</span>
          <span class="trader-detail__value"><%= @allocation_task.run_on %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">Status</span>
          <span class="trader-detail__value"><%= @allocation_task.status %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">Start Time</span>
          <span class="trader-detail__value"><%= @allocation_task.started_at || "-" %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">End Time</span>
          <span class="trader-detail__value"><%= @allocation_task.completed_at || "-" %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">Starting Cash</span>
          <span class="trader-detail__value"><%= number_to_currency(@allocation_task.starting_cash, unit: "$", precision: 2) %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">Ending Cash</span>
          <span class="trader-detail__value"><%= number_to_currency(@allocation_task.ending_cash, unit: "$", precision: 2) %></span>
        </div>
        <div class="trader-detail__item">
          <span class="trader-detail__label">Portfolio Value</span>
          <span class="trader-detail__value"><%= number_to_currency(@allocation_task.portfolio_value, unit: "$", precision: 2) %></span>
        </div>
      </div>

      <% if @allocation_task.summary.present? %>
        <div class="trader-detail__description">
          <h3 class="trader-detail__description-title">Execution Summary</h3>
          <p class="trader-detail__description-text"><%= @allocation_task.summary %></p>
        </div>
      <% end %>

      <% if @allocation_task.error_message.present? %>
        <div class="alert alert-error">
          <p><%= @allocation_task.error_message %></p>
        </div>
      <% end %>
    </div>

    <div class="preview-section">
      <div class="preview-section__header">
        <h2 class="preview-section__title">Execution Payload</h2>
      </div>
      <pre class="json-viewer"><%= JSON.pretty_generate(@allocation_task.execution_payload || {}) %></pre>
    </div>

    <% if @allocation_task.trader_trades.recent.any? %>
      <div class="preview-section">
        <div class="preview-section__header">
          <h2 class="preview-section__title">Trade History</h2>
        </div>
        <div class="data-table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Action</th>
                <th>Asset</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Amount</th>
                <th>Reason</th>
              </tr>
            </thead>
            <tbody>
              <% @allocation_task.trader_trades.recent.each do |trade| %>
                <tr>
                  <td><span class="action-badge action-badge--<%= trade.action %>"><%= trade.action.upcase %></span></td>
                  <td><strong><%= trade.asset.symbol %></strong></td>
                  <td><%= number_with_precision(trade.quantity, precision: 6, strip_insignificant_zeros: true) %></td>
                  <td><%= number_to_currency(trade.price, unit: "$", precision: 2) %></td>
                  <td><%= number_to_currency(trade.amount, unit: "$", precision: 2) %></td>
                  <td class="text-small"><%= trade.reason %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </main>
</div>
