<% content_for :title, "编辑因子日报 - #{@report.report_date}" %>

<div class="reports-container">
  <!-- Background -->
  <div class="factors-background">
    <div class="factors-background__gradient"></div>
    <div class="factors-background__grid"></div>
  </div>

  <!-- Header -->
  <header class="reports-header">
    <div class="reports-header__left">
      <%= link_to admin_factor_daily_report_path(@report), class: "back-link" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>
        返回详情
      <% end %>
      <h1>编辑因子日报</h1>
    </div>
  </header>

  <!-- Form -->
  <div class="report-form-container">
    <%= form_with model: @report, url: admin_factor_daily_report_path(@report), method: :patch, local: true, class: "report-form" do |f| %>
      <div class="form-group">
        <%= f.label :summary, "摘要", class: "form-label" %>
        <%= f.text_area :summary, rows: 3, class: "form-input form-input--textarea", placeholder: "简要描述今日要点" %>
      </div>

      <div class="form-group">
        <%= f.label :content, "内容 (Markdown)", class: "form-label" %>
        <%= f.text_area :content, rows: 20, class: "form-input form-input--textarea", placeholder: "使用 Markdown 格式编写日报内容" %>
      </div>

      <div class="form-group">
        <%= f.label :published, "发布状态", class: "form-label" %>
        <div class="form-checkbox">
          <%= f.check_box :published %>
          <%= f.label :published, "已发布" %>
        </div>
      </div>

      <div class="form-actions">
        <%= f.submit "更新日报", class: "btn btn-primary" %>
        <%= link_to "取消", admin_factor_daily_report_path(@report), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
