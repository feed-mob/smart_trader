<% content_for :title, "信号日报 - #{@report.report_date}" %>

<div class="report-detail-container">
  <!-- Header -->
  <header class="report-detail-header">
    <div class="report-detail-header__left">
      <%= link_to admin_signal_daily_reports_path, class: "back-link" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>
        返回列表
      <% end %>
      <div class="report-detail-header__title-group">
        <h1>信号日报</h1>
        <span class="report-date"><%= @report.report_date.strftime('%Y年%m月%d日') %></span>
      </div>
    </div>
    <div class="report-detail-header__actions">
      <%= link_to edit_admin_signal_daily_report_path(@report), class: "btn btn-secondary", title: "编辑日报" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
        编辑
      <% end %>
      <%= button_to regenerate_admin_signal_daily_report_path(@report),
          method: :post,
          class: "btn btn-primary",
          title: "重新生成",
          data: { turbo_confirm: "确定要重新生成此日报吗？" } do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
          <path d="M16 21h5v-5"></path>
        </svg>
        重新生成
      <% end %>
    </div>
  </header>

  <!-- Summary -->
  <section class="report-detail-summary">
    <h3>摘要</h3>
    <p><%= @report.summary %></p>
  </section>

  <!-- Content -->
  <section class="report-detail-content">
    <div class="markdown-body">
      <%= render_markdown(@report.content) %>
    </div>
  </section>

  <!-- Statistics -->
  <% if @report.statistics.present? && @report.statistics.any? { |k, v| k != 'report_date' } %>
  <section class="report-detail-stats">
    <h3>统计信息</h3>
    <div class="stats-grid">
      <% @report.statistics.each do |key, value| %>
        <% next if key == 'report_date' %>
        <div class="stat-item">
          <span class="stat-label"><%= key.to_s.humanize %></span>
          <span class="stat-value"><%= format_stat_value(value) %></span>
        </div>
      <% end %>
    </div>
  </section>
  <% end %>

  <!-- Metadata -->
  <footer class="report-detail-meta">
    <div class="meta-item">
      <span class="meta-label">生成方式</span>
      <span class="meta-value"><%= @report.generated_by.upcase %></span>
    </div>
    <% if @report.model_version.present? %>
    <div class="meta-item">
      <span class="meta-label">模型版本</span>
      <span class="meta-value"><%= @report.model_version %></span>
    </div>
    <% end %>
    <% if @report.generation_time_ms.present? %>
    <div class="meta-item">
      <span class="meta-label">生成耗时</span>
      <span class="meta-value"><%= @report.generation_time_ms %>ms</span>
    </div>
    <% end %>
    <div class="meta-item">
      <span class="meta-label">生成时间</span>
      <span class="meta-value"><%= @report.created_at.strftime('%Y-%m-%d %H:%M:%S') %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">状态</span>
      <span class="meta-value <%= @report.published? ? 'published' : 'draft' %>"><%= @report.published_label %></span>
    </div>
  </footer>
</div>
