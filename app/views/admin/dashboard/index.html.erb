<% content_for :title, "Admin 管理面板" %>

<div class="signals-container">
  <!-- Background -->
  <div class="signals-background">
    <div class="signals-background__gradient"></div>
    <div class="signals-background__grid"></div>
  </div>

  <!-- Header -->
  <div class="signals-header">
    <div class="signals-header__left">
      <%= link_to root_path, class: "signals-home-link" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9v11a2H5a2 2H5a2z"></path>
          <polyline points="9 22 9 12 15 22"></polyline>
        </svg>
      <% end %>
      <div>
        <h1 class="signals-header__title">Admin 管理面板</h1>
        <p class="signals-header__subtitle">系统管理入口</p>
      </div>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="signals-stats">
    <div class="stat-card stat-card--total">
      <div class="stat-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
        </svg>
      </div>
      <div class="stat-card__content">
        <span class="stat-card__value"><%= @factor_count %></span>
        <span class="stat-card__label">活跃因子</span>
      </div>
    </div>
    <div class="stat-card stat-card--buy">
      <div class="stat-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <div class="stat-card__content">
        <span class="stat-card__value"><%= @signal_count %></span>
        <span class="stat-card__label">交易信号</span>
      </div>
    </div>
    <div class="stat-card stat-card--sell">
      <div class="stat-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
      </div>
      <div class="stat-card__content">
        <span class="stat-card__value"><%= @job_stats[:failed] %></span>
        <span class="stat-card__label">失败 Job</span>
      </div>
    </div>
    <div class="stat-card stat-card--high">
      <div class="stat-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="3" y1="9" x2="21" y2="9"></line>
        </svg>
      </div>
      <div class="stat-card__content">
        <span class="stat-card__value"><%= @job_stats[:total] %></span>
        <span class="stat-card__label">总 Job 数</span>
      </div>
    </div>
  </div>

  <!-- Module Cards -->
  <div class="admin-modules">
    <%= link_to admin_factor_definitions_path, class: "admin-module-card" do %>
      <div class="admin-module-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </div>
      <div class="admin-module-card__content">
        <h3 class="admin-module-card__title">因子定义</h3>
        <p class="admin-module-card__desc">管理交易因子，定义因子参数和权重</p>
      </div>
      <div class="admin-module-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 19"></polyline>
        </svg>
      </div>
    <% end %>

    <%= link_to admin_trading_signals_path, class: "admin-module-card" do %>
      <div class="admin-module-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <div class="admin-module-card__content">
        <h3 class="admin-module-card__title">交易信号</h3>
        <p class="admin-module-card__desc">查看 AI 生成的交易信号</p>
      </div>
      <div class="admin-module-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 19"></polyline>
        </svg>
      </div>
    <% end %>

    <%= link_to admin_job_executions_path, class: "admin-module-card" do %>
      <div class="admin-module-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="3" y1="9" x2="21" y2="9"></line>
        </svg>
      </div>
      <div class="admin-module-card__content">
        <h3 class="admin-module-card__title">Job 监控</h3>
        <p class="admin-module-card__desc">查看后台任务执行记录</p>
      </div>
      <div class="admin-module-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 19"></polyline>
        </svg>
      </div>
    <% end %>

    <%= link_to sidekiq_web_path, class: "admin-module-card", target: "_blank" do %>
      <div class="admin-module-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5-10-5z"></path>
          <path d="M2 12l10 5 10-5-10-5z"></path>
        </svg>
      </div>
      <div class="admin-module-card__content">
        <h3 class="admin-module-card__title">Sidekiq 监控</h3>
        <p class="admin-module-card__desc">Sidekiq 队列管理界面</p>
      </div>
      <div class="admin-module-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 19"></polyline>
        </svg>
      </div>
    <% end %>
  </div>

  <!-- Recent Jobs -->
  <div class="signals-section">
    <h2 class="signals-section__title">最近执行</h2>
    <div class="signals-table-wrapper">
      <table class="signals-table">
        <thead>
          <tr>
            <th>Job 名称</th>
            <th>状态</th>
            <th>开始时间</th>
            <th>耗时</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_jobs.each do |job| %>
            <tr class="signals-table__row signals-table__row--<%= job.status %>">
              <td><%= job.job_name %></td>
              <td>
                <span class="signal-badge signal-badge--<%= status_badge_class(job.status) %>">
                  <%= status_label(job.status) %>
                </span>
              </td>
              <td><%= job.started_at.strftime("%m-%d %H:%M") %></td>
              <td><%= job.formatted_duration %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .admin-modules {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .admin-module-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    text-decoration: none;
    color: #F8FAFC;
    transition: all 0.3s ease;
  }

  .admin-module-card:hover {
    background: rgba(15, 23, 42, 0.8);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .admin-module-card__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.1);
    border-radius: 0.75rem;
  }

  .admin-module-card__icon svg {
    width: 24px;
    height: 24px;
    color: #22d3ee;
  }

  .admin-module-card__content {
    flex: 1;
  }

  .admin-module-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
  }

  .admin-module-card__desc {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
  }

  .admin-module-card__arrow {
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .admin-module-card:hover .admin-module-card__arrow {
    opacity: 1;
  }

  .admin-module-card__arrow svg {
    width: 20px;
    height: 20px;
  }
</style>
