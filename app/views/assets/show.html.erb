<% content_for :title, "#{@asset.symbol} - #{@asset.name} - SmartTrader" %>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-6">
    <%= link_to '← 返回列表', assets_path,
          class: "text-blue-600 hover:text-blue-700 font-medium" %>

    <div class="flex items-center justify-between mt-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @asset.symbol %></h1>
        <p class="text-lg text-gray-600"><%= @asset.name %></p>
      </div>
      <span class="px-3 py-1 rounded text-sm font-medium <%= asset_type_badge(@asset.asset_type) %>">
        <%= @asset.asset_type.upcase %>
      </span>
    </div>
  </div>

  <!-- Current Price Card -->
  <div class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500 mb-1">当前价格</p>
      <p class="text-4xl font-bold text-gray-900">
        <%= number_to_currency(@asset.current_price) %>
      </p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500 mb-1">24小时变化</p>
      <% if @asset.latest_snapshot && @asset.latest_snapshot.change_percent %>
        <p class="text-4xl font-bold <%= @asset.latest_snapshot.change_percent >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= @asset.latest_snapshot.change_percent >= 0 ? '+' : '' %><%= @asset.latest_snapshot.change_percent.round(2) %>%
        </p>
      <% else %>
        <p class="text-4xl font-bold text-gray-400">-</p>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500 mb-1">最后更新</p>
      <p class="text-2xl font-semibold text-gray-700">
        <%= @asset.last_updated&.strftime('%Y-%m-%d %H:%M') || 'N/A' %>
      </p>
    </div>
  </div>

  <!-- Timeframe Selector -->
  <div class="mb-8 flex items-center gap-4">
    <span class="text-gray-600">时间范围：</span>
    <% ['1h', '6h', '24h', '7d', '30d'].each do |tf| %>
      <%= link_to timeframe_label(tf), asset_path(@asset, timeframe: tf),
            class: "px-4 py-2 rounded-lg #{tf == @timeframe ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <% end %>
  </div>

  <!-- Statistics Card -->
  <div class="mb-8 bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">统计信息</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="text-center">
        <p class="text-sm text-gray-500">数据快照</p>
        <p class="text-3xl font-bold text-gray-900">
          <%= @snapshots.count %>
        </p>
      </div>
      <div class="text-center">
        <p class="text-sm text-gray-500">最早记录</p>
        <p class="text-xl font-semibold text-gray-700">
          <%= @snapshots.last&.captured_at&.strftime('%Y-%m-%d %H:%M') || '-' %>
        </p>
      </div>
      <div class="text-center">
        <p class="text-sm text-gray-500">最新记录</p>
        <p class="text-xl font-semibold text-gray-700">
          <%= @snapshots.first&.captured_at&.strftime('%Y-%m-%d %H:%M') || '-' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Recent Snapshots Table -->
  <div class="mb-8 bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">最近快照记录</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-2 text-left text-gray-600">时间</th>
            <th class="px-4 py-2 text-right text-gray-600">价格</th>
            <th class="px-4 py-2 text-right text-gray-600">24h变化</th>
          </tr>
        </thead>
        <tbody>
          <% @snapshots.each do |snapshot| %>
            <tr class="border-b">
              <td class="px-4 py-2">
                <%= snapshot.captured_at&.strftime('%Y-%m-%d %H:%M') %>
              </td>
              <td class="px-4 py-2 text-right">
                <%= number_to_currency(snapshot.price, precision: 4) %>
              </td>
              <td class="px-4 py-2 text-right <%= snapshot.change_percent >= 0 ? 'text-green-600' : 'text-red-600' %>">
                <%= snapshot.change_percent ? "#{snapshot.change_percent >= 0 ? '+' : ''}#{snapshot.change_percent.round(2)}%" : '-' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
