<% content_for :title, "#{@trader.name} - SmartTrader" %>

<div class="traders-container">
  <!-- Animated Background -->
  <div class="traders-background">
    <div class="traders-background__gradient"></div>
    <div class="traders-background__grid"></div>
  </div>

  <!-- Header -->
  <header class="traders-header">
    <div class="traders-header__left">
      <%= link_to traders_path, class: "traders-logo" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      <% end %>
      <h1 class="traders-header__title"><%= @trader.name %></h1>
    </div>
    <div class="traders-header__right">
      <%= link_to "AI Allocation", trader_allocation_preview_path(@trader), class: "btn btn-primary" %>
      <%= link_to "Allocation Records", allocation_decisions_path, class: "btn btn-secondary" %>
      <%= link_to "Task Records", allocation_tasks_path, class: "btn btn-secondary" %>
      <%= link_to "Edit", edit_trader_path(@trader), class: "btn btn-secondary" %>
      <%= button_to "Delete", @trader, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure you want to delete this trader?" } %>
    </div>
  </header>

  <!-- Main Content -->
  <main class="traders-main">
    <% if notice.present? %>
      <div class="alert alert-success">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="alert alert-danger">
        <%= alert %>
      </div>
    <% end %>

    <!-- Trader Info Card -->
    <div class="trader-detail">
      <div class="trader-detail__section">
        <h2 class="trader-detail__section-title">Basic Information</h2>
        <div class="trader-detail__grid">
          <div class="trader-detail__item">
            <span class="trader-detail__label">Risk Level</span>
            <span class="trader-detail__value">
              <span class="risk-badge risk-badge--<%= @trader.risk_level %>"><%= @trader.display_risk_level %></span>
            </span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Status</span>
            <span class="trader-detail__value">
              <span class="status-indicator status-indicator--<%= @trader.status %>"></span>
              <%= @trader.display_status %>
            </span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Initial Capital</span>
            <span class="trader-detail__value"><%= number_to_currency(@trader.initial_capital, unit: "$", precision: 2) %></span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Current Capital</span>
            <span class="trader-detail__value"><%= number_to_currency(@latest_portfolio_snapshot&.portfolio_value || @trader.current_capital_value, unit: "$", precision: 2) %></span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Profit/Loss</span>
            <% current_profit_loss = @latest_portfolio_snapshot&.profit_loss || @trader.profit_loss %>
            <span class="trader-detail__value <%= current_profit_loss >= 0 ? 'positive' : 'negative' %>">
              <%= current_profit_loss >= 0 ? '+' : '' %><%= number_to_currency(current_profit_loss, unit: "$", precision: 2) %>
            </span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Return Rate</span>
            <% current_profit_loss_percent = @latest_portfolio_snapshot&.profit_loss_percent || @trader.profit_loss_percent %>
            <span class="trader-detail__value <%= current_profit_loss_percent >= 0 ? 'positive' : 'negative' %>">
              <%= current_profit_loss_percent >= 0 ? '+' : '' %><%= current_profit_loss_percent %>%
            </span>
          </div>
        </div>

        <% if @trader.description.present? %>
          <div class="trader-detail__description">
            <h3 class="trader-detail__description-title">Investment Style</h3>
            <p class="trader-detail__description-text"><%= @trader.description %></p>
          </div>
        <% end %>
      </div>

      <!-- Multi-Strategy Matrix Section -->
      <div class="trader-detail__section">
        <h2 class="trader-detail__section-title">
          Strategy Matrix
          <span class="strategy-matrix-hint">(AI will automatically select strategy based on market conditions)</span>
        </h2>

        <% if @strategies.any? %>
          <!-- Strategy Cards Grid -->
          <div class="strategy-matrix-grid">
            <% @strategies.each do |strategy| %>
              <div class="strategy-card">
                <div class="strategy-card__header">
                  <h3 class="strategy-card__name"><%= strategy.name %></h3>
                  <span class="strategy-card__condition strategy-card__condition--<%= strategy.market_condition %>">
                    <%= strategy.display_market_condition %>
                  </span>
                </div>

                <% if strategy.description.present? %>
                  <p class="strategy-card__description"><%= strategy.description %></p>
                <% end %>

                <div class="strategy-card__params">
                  <div class="strategy-param">
                    <span class="strategy-param__label">Max Positions</span>
                    <span class="strategy-param__value"><%= strategy.max_positions %> assets</span>
                  </div>
                  <div class="strategy-param">
                    <span class="strategy-param__label">Buy Signal Threshold</span>
                    <span class="strategy-param__value"><%= (strategy.buy_signal_threshold * 100).to_i %>%</span>
                  </div>
                  <div class="strategy-param">
                    <span class="strategy-param__label">Max Position Size</span>
                    <span class="strategy-param__value"><%= (strategy.max_position_size * 100).to_i %>%</span>
                  </div>
                  <div class="strategy-param">
                    <span class="strategy-param__label">Min Cash Reserve</span>
                    <span class="strategy-param__value"><%= (strategy.min_cash_reserve * 100).to_i %>%</span>
                  </div>
                </div>

                <div class="strategy-card__footer">
                  <span class="strategy-source strategy-source--<%= strategy.generated_by %>">
                    <%= strategy.display_generated_by %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="strategy-empty">
            <p>No trading strategies yet. Please edit trader information to generate strategies.</p>
            <%= link_to "Edit Trader", edit_trader_path(@trader), class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>

      <div class="trader-detail__section">
        <h2 class="trader-detail__section-title">Simulation Overview</h2>

        <div class="trader-detail__grid">
          <div class="trader-detail__item">
            <span class="trader-detail__label">Latest Execution Status</span>
            <span class="trader-detail__value"><%= @latest_allocation_task&.status || "-" %></span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Latest Execution Date</span>
            <span class="trader-detail__value"><%= @latest_allocation_task&.run_on || "-" %></span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Current Holdings Count</span>
            <span class="trader-detail__value"><%= @trader_positions.size %></span>
          </div>
          <div class="trader-detail__item">
            <span class="trader-detail__label">Current Net Value</span>
            <span class="trader-detail__value"><%= number_to_currency(@latest_portfolio_snapshot&.portfolio_value || @trader.current_capital_value, unit: "$", precision: 2) %></span>
          </div>
        </div>

        <% if @latest_allocation_task.present? %>
          <div class="trader-detail__description">
            <h3 class="trader-detail__description-title">Recent Execution Summary</h3>
            <p class="trader-detail__description-text"><%= @latest_allocation_task.summary.presence || "No summary" %></p>
            <p class="trader-detail__description-text">
              Cash: <%= number_to_currency(@latest_portfolio_snapshot&.cash_value || @latest_allocation_task.ending_cash, unit: "$", precision: 2) %>,
              Portfolio Value: <%= number_to_currency(@latest_portfolio_snapshot&.portfolio_value || @latest_allocation_task.portfolio_value, unit: "$", precision: 2) %>
              <% if @latest_allocation_task.allocation_decision.present? %>
                , <%= link_to "View Recommendation", allocation_decision_path(@latest_allocation_task.allocation_decision), class: "text-link" %>
              <% end %>
            </p>
          </div>
        <% end %>

        <% if @trader_positions.any? %>
          <div class="data-table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Asset</th>
                  <th>Quantity</th>
                  <th>Avg Cost</th>
                  <th>Current Price</th>
                  <th>Market Value</th>
                  <th>Unrealized P/L</th>
                </tr>
              </thead>
              <tbody>
                <% @trader_position_rows.each do |row| %>
                  <% position = row[:position] %>
                  <tr>
                    <td><strong><%= position.asset.symbol %></strong> <span class="text-muted"><%= position.asset.name %></span></td>
                    <td><%= number_with_precision(position.quantity, precision: 6, strip_insignificant_zeros: true) %></td>
                    <td><%= number_to_currency(position.average_cost, unit: "$", precision: 2) %></td>
                    <td><%= number_to_currency(row[:latest_price], unit: "$", precision: 2) %></td>
                    <td><%= number_to_currency(row[:market_value], unit: "$", precision: 2) %></td>
                    <td class="<%= row[:unrealized_pnl] >= 0 ? 'positive' : 'negative' %>">
                      <%= row[:unrealized_pnl] >= 0 ? '+' : '' %><%= number_to_currency(row[:unrealized_pnl], unit: "$", precision: 2) %>
                      (<%= row[:unrealized_pnl_percent] >= 0 ? '+' : '' %><%= row[:unrealized_pnl_percent].to_f.round(2) %>%)
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="strategy-empty">
            <p>No current holdings. After executing an allocation recommendation, holdings will be displayed here.</p>
          </div>
        <% end %>

        <% if @recent_trader_trades.any? %>
          <div class="trader-detail__description">
            <h3 class="trader-detail__description-title">Recent Trade History</h3>
          </div>
          <div class="data-table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Time</th>
                  <th>Action</th>
                  <th>Asset</th>
                  <th>Quantity</th>
                  <th>Price</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_trader_trades.each do |trade| %>
                  <tr>
                    <td><%= l(trade.executed_at, format: :short) %></td>
                    <td><span class="action-badge action-badge--<%= trade.action %>"><%= trade.action.upcase %></span></td>
                    <td><strong><%= trade.asset.symbol %></strong></td>
                    <td><%= number_with_precision(trade.quantity, precision: 6, strip_insignificant_zeros: true) %></td>
                    <td><%= number_to_currency(trade.price, unit: "$", precision: 2) %></td>
                    <td><%= number_to_currency(trade.amount, unit: "$", precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>

      <div class="trader-detail__section">
        <h2 class="trader-detail__section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--reflection-accent);">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"></path>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
          </svg>
          Trading Reflection Report
        </h2>

        <div class="reflection-preview">
          <div class="reflection-preview__header">
            <div class="reflection-preview__intro">
              <p class="reflection-preview__description">
                Generate a reflection report based on the last 30 days of strategies, trades, execution records, portfolio snapshots, and current holdings to help optimize trading strategies.
              </p>
            </div>
            <div class="reflection-preview__generate-btn">
              <%= button_to "Generate Reflection", trader_trader_reflections_path(@trader), method: :post, class: "reflection-report__btn reflection-report__btn--primary" %>
            </div>
          </div>

          <% if @latest_trader_reflection&.generated? %>
            <% findings = @latest_trader_reflection.findings || {} %>
            <% suggested_adjustments = Array(@latest_trader_reflection.suggested_adjustments) %>

            <div class="reflection-preview__report-card">
              <div class="reflection-preview__report-header">
                <div class="reflection-preview__report-meta">
                  <span class="reflection-preview__report-eyebrow">Latest Report</span>
                  <div class="reflection-preview__report-period">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <%= @latest_trader_reflection.reflection_period_start %> to <%= @latest_trader_reflection.reflection_period_end %>
                  </div>
                </div>
                <%= link_to trader_trader_reflection_path(@trader, @latest_trader_reflection), class: "reflection-preview__report-link" do %>
                  View Full Report
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                <% end %>
              </div>

              <% if @latest_trader_reflection.llm_summary.present? %>
                <div class="reflection-preview__summary">
                  <p class="reflection-preview__summary-text"><%= @latest_trader_reflection.llm_summary %></p>
                </div>
              <% end %>

              <div class="reflection-preview__findings">
                <div class="reflection-preview__finding-item reflection-preview__finding-item--strengths">
                  <div class="reflection-preview__finding-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                    </svg>
                    Strengths
                  </div>
                  <div class="reflection-preview__finding-value">
                    <%= Array(findings["strengths"]).first.presence || "-" %>
                  </div>
                </div>

                <div class="reflection-preview__finding-item reflection-preview__finding-item--mistakes">
                  <div class="reflection-preview__finding-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="15" y1="9" x2="9" y2="15"></line>
                      <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    Mistakes
                  </div>
                  <div class="reflection-preview__finding-value">
                    <%= Array(findings["mistakes"]).first.presence || "-" %>
                  </div>
                </div>

                <div class="reflection-preview__finding-item reflection-preview__finding-item--risks">
                  <div class="reflection-preview__finding-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                      <line x1="12" y1="9" x2="12" y2="13"></line>
                      <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    Risk Warnings
                  </div>
                  <div class="reflection-preview__finding-value">
                    <%= Array(findings["risk_issues"]).first.presence || "-" %>
                  </div>
                </div>

                <div class="reflection-preview__finding-item reflection-preview__finding-item--adjustments">
                  <div class="reflection-preview__finding-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="4" y1="21" x2="4" y2="14"></line>
                      <line x1="4" y1="10" x2="4" y2="3"></line>
                      <line x1="12" y1="21" x2="12" y2="12"></line>
                      <line x1="12" y1="8" x2="12" y2="3"></line>
                      <line x1="20" y1="21" x2="20" y2="16"></line>
                      <line x1="20" y1="12" x2="20" y2="3"></line>
                    </svg>
                    Suggested Adjustments
                  </div>
                  <div class="reflection-preview__finding-count">
                    <%= suggested_adjustments.size %>
                  </div>
                </div>
              </div>

              <div class="reflection-preview__footer">
                <div class="reflection-preview__generated-time">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  Generated: <%= l(@latest_trader_reflection.generated_at, format: :short) if @latest_trader_reflection.generated_at.present? %>
                </div>
              </div>
            </div>
          <% elsif @latest_trader_reflection&.failed? %>
            <div class="reflection-preview__error">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
              <span class="reflection-preview__error-text">
                Last reflection report generation failed: <%= @latest_trader_reflection.error_message %>
              </span>
            </div>
          <% else %>
            <div class="reflection-preview__empty">
              <svg class="reflection-preview__empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
              </svg>
              <p class="reflection-preview__empty-text">No reflection reports yet. Generate a report for the last 30 days to help optimize strategy parameters.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Back Link -->
    <div class="trader-actions">
      <%= link_to "Back to List", traders_path, class: "btn btn-ghost" %>
    </div>
  </main>
</div>
