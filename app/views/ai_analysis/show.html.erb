<% content_for :title, "Analysis Result ##{@record.id}" %>

<% is_processing = @record.pending? || @record.running? %>

<div class="neural-result"
     <% if is_processing %>
       data-controller="ai-analysis-polling"
       data-ai-analysis-polling-status-url-value="<%= status_ai_analysis_path(@record.id) %>"
     <% end %>>
  <div class="neural-result__grid"></div>
  <div class="neural-result__scanline"></div>

  <div class="neural-result-container">
    <header class="neural-result-header">
      <div class="neural-result-logo">
        <div class="neural-result-logo__icon">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M16 2L4 9v14l12 7 12-7V9L16 2z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M16 10l6 3.5v7L16 24l-6-3.5v-7L16 10z" fill="currentColor" opacity="0.3"/>
            <circle cx="16" cy="16" r="3" fill="currentColor"/>
          </svg>
        </div>
        <div class="neural-result-logo__text">
          <span class="neural-result-logo__eyebrow">SmartTrader AI</span>
          <span class="neural-result-logo__title">Analysis #<%= @record.id %></span>
        </div>
      </div>
      <div class="neural-result-header__actions">
        <%= link_to new_ai_analysis_path, class: "neural-result-btn neural-result-btn--primary" do %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <span>New</span>
        <% end %>
        <%= link_to ai_analysis_index_path, class: "neural-result-btn" do %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 6h18M3 12h18M3 18h18"/>
          </svg>
          <span>History</span>
        <% end %>
        <%= link_to root_path, class: "neural-result-btn" do %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
        <% end %>
      </div>
    </header>

    <% if is_processing %>
      <!-- Processing State -->
      <div class="neural-result-status">
        <div class="neural-result-status__item">
          <div class="neural-result-status__icon neural-result-status__icon--running">
            <svg class="neural-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 2a10 10 0 0110 10" stroke-dasharray="30 60"/>
            </svg>
          </div>
          <div class="neural-result-status__content">
            <span class="neural-result-status__label">Status</span>
            <span class="neural-result-status__value neural-result-status__value--running">
              <%= @record.running? ? "RUNNING" : "PENDING" %>
            </span>
          </div>
        </div>

        <div class="neural-result-status__divider"></div>

        <div class="neural-result-status__item">
          <div class="neural-result-status__icon neural-result-status__icon--mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <div class="neural-result-status__content">
            <span class="neural-result-status__label">Permission</span>
            <span class="neural-result-status__value"><%= @record.permission_mode.presence || "default" %></span>
          </div>
        </div>
      </div>

      <main class="neural-result-main">
        <section class="neural-result-section">
          <div class="neural-result-section__header">
            <div class="neural-result-section__title">
              <span class="neural-result-section__prompt-icon">$</span>
              <span>Prompt</span>
            </div>
            <span class="neural-result-section__badge">INPUT</span>
          </div>
          <div class="neural-result-section__body neural-result-section__body--prompt">
            <pre><%= @record.prompt %></pre>
          </div>
        </section>

        <div class="neural-processing-panel">
          <div class="neural-processing-panel__pulse"></div>
          <svg class="neural-processing-panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span class="neural-processing-panel__text">Claude Code is analyzing your request...</span>
          <div class="neural-processing-panel__dots">
            <span></span><span></span><span></span>
          </div>
        </div>
      </main>
    <% else %>
      <!-- Finished State -->
      <div class="neural-result-status">
        <div class="neural-result-status__item">
          <div class="neural-result-status__icon neural-result-status__icon--<%= @record.success? ? 'success' : 'error' %>">
            <% if @record.success? %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            <% else %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            <% end %>
          </div>
          <div class="neural-result-status__content">
            <span class="neural-result-status__label">Status</span>
            <span class="neural-result-status__value neural-result-status__value--<%= @record.success? ? 'success' : 'error' %>">
              <%= @record.status.upcase %>
            </span>
          </div>
        </div>

        <div class="neural-result-status__divider"></div>

        <div class="neural-result-status__item">
          <div class="neural-result-status__icon neural-result-status__icon--mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <div class="neural-result-status__content">
            <span class="neural-result-status__label">Permission</span>
            <span class="neural-result-status__value"><%= @record.permission_mode.presence || "default" %></span>
          </div>
        </div>

        <div class="neural-result-status__divider"></div>

        <div class="neural-result-status__item">
          <div class="neural-result-status__icon neural-result-status__icon--files">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
          </div>
          <div class="neural-result-status__content">
            <span class="neural-result-status__label">Files</span>
            <span class="neural-result-status__value"><%= @record.files_list.count %></span>
          </div>
        </div>

        <% if @record.duration_text %>
          <div class="neural-result-status__divider"></div>
          <div class="neural-result-status__item">
            <div class="neural-result-status__icon neural-result-status__icon--time">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </div>
            <div class="neural-result-status__content">
              <span class="neural-result-status__label">Duration</span>
              <span class="neural-result-status__value"><%= @record.duration_text %></span>
            </div>
          </div>
        <% end %>
      </div>

      <main class="neural-result-main">
        <section class="neural-result-section">
          <div class="neural-result-section__header">
            <div class="neural-result-section__title">
              <span class="neural-result-section__prompt-icon">$</span>
              <span>Prompt</span>
            </div>
            <span class="neural-result-section__badge">INPUT</span>
          </div>
          <div class="neural-result-section__body neural-result-section__body--prompt">
            <pre><%= @record.prompt %></pre>
          </div>
        </section>

        <% if @record.files_list.any? %>
          <section class="neural-result-section">
            <div class="neural-result-section__header">
              <div class="neural-result-section__title">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
                </svg>
                <span>Context Files</span>
              </div>
              <span class="neural-result-section__badge neural-result-section__badge--info"><%= pluralize(@record.files_list.count, 'file') %></span>
            </div>
            <div class="neural-result-section__body neural-result-section__body--files">
              <ul class="neural-result-files">
                <% @record.files_list.each do |file| %>
                  <li class="neural-result-files__item">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <span><%= file %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          </section>
        <% end %>

        <section class="neural-result-section">
          <div class="neural-result-section__header">
            <div class="neural-result-section__title">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="4 17 10 11 4 5"/>
                <line x1="12" y1="19" x2="20" y2="19"/>
              </svg>
              <span>Output</span>
            </div>
            <span class="neural-result-section__badge neural-result-section__badge--success">RESULT</span>
          </div>
          <div class="neural-result-section__body neural-result-section__body--output">
            <div class="neural-result-section__glow"></div>
            <pre><%= @record.output.presence || "(no output)" %></pre>
          </div>
        </section>

        <% if @record.error.present? %>
          <section class="neural-result-section">
            <div class="neural-result-section__header">
              <div class="neural-result-section__title neural-result-section__title--error">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>Error</span>
              </div>
              <span class="neural-result-section__badge neural-result-section__badge--error">ERROR</span>
            </div>
            <div class="neural-result-section__body neural-result-section__body--error">
              <pre><%= @record.error %></pre>
            </div>
          </section>
        <% end %>
      </main>
    <% end %>

    <footer class="neural-result-footer">
      <div class="neural-result-footer__timestamp">
        <span class="neural-result-footer__label">Created at</span>
        <span class="neural-result-footer__value"><%= @record.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
      </div>
      <div class="neural-result-footer__actions">
        <button onclick="navigator.clipboard.writeText(document.querySelector('.neural-result-section__body--output pre')?.textContent || '')"
                class="neural-result-btn neural-result-btn--small">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <span>Copy Output</span>
        </button>
      </div>
    </footer>
  </div>
</div>
