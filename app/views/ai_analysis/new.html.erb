<% content_for :title, "Neural Terminal" %>

<div class="neural-terminal">
  <div class="neural-grid"></div>

  <div class="neural-particles">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="neural-container">
    <header class="neural-header">
      <div class="neural-logo">
        <div class="neural-logo__icon">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M16 2L4 9v14l12 7 12-7V9L16 2z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M16 10l6 3.5v7L16 24l-6-3.5v-7L16 10z" fill="currentColor" opacity="0.3"/>
            <circle cx="16" cy="16" r="3" fill="currentColor"/>
          </svg>
        </div>
        <div class="neural-logo__text">
          <span class="neural-logo__eyebrow">SmartTrader AI</span>
          <span class="neural-logo__title">Neural Terminal</span>
        </div>
      </div>
      <nav class="neural-nav">
        <%= link_to ai_analysis_index_path, class: "neural-nav__link" do %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>History</span>
        <% end %>
        <%= link_to root_path, class: "neural-nav__link" do %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Dashboard</span>
        <% end %>
      </nav>
    </header>

    <main class="neural-panel">
      <div class="neural-panel__glow"></div>

      <div class="neural-terminal-header">
        <div class="neural-terminal-header__dots">
          <span></span><span></span><span></span>
        </div>
        <div class="neural-terminal-header__title">
          <span class="neural-cursor">claude</span>@neural:~$
        </div>
        <div class="neural-terminal-header__status">
          <span class="neural-status neural-status--ready">READY</span>
        </div>
      </div>

      <div class="neural-content">
        <%= form_with url: ai_analysis_index_path, method: :post, local: true, class: "neural-form", multipart: true do |f| %>
          <div class="neural-field">
            <div class="neural-field__header">
              <div class="neural-field__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                </svg>
              </div>
              <div class="neural-field__label-group">
                <%= f.label :prompt, "Command Prompt", class: "neural-field__label" %>
                <span class="neural-field__hint">Natural language instructions for Claude</span>
              </div>
            </div>
            <div class="neural-textarea-wrapper">
              <%= f.text_area :prompt,
                  value: @default_prompt,
                  rows: 8,
                  class: "neural-textarea",
                  placeholder: "Enter your request...",
                  spellcheck: false %>
            </div>
          </div>

          <div class="neural-columns">
            <div class="neural-field">
              <div class="neural-field__header">
                <div class="neural-field__icon neural-field__icon--files">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                  </svg>
                </div>
                <div class="neural-field__label-group">
                  <%= f.label :uploaded_files, "Context Files", class: "neural-field__label" %>
                  <span class="neural-field__hint">Upload images, documents, or any files</span>
                </div>
              </div>
              <div class="neural-upload-area" data-controller="file-upload" data-file-upload-placeholder-value="Drop files here or click to browse">
                <input type="file" name="ai_analysis_record[uploaded_files][]" id="ai_analysis_record_uploaded_files" multiple class="neural-upload-input" data-file-upload-target="input">
                <div class="neural-upload-content" data-file-upload-target="content">
                  <svg class="neural-upload-content__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                  </svg>
                  <span class="neural-upload-content__text">Drop files here or click to browse</span>
                  <span class="neural-upload-content__hint">Supports images, documents, and any file type</span>
                </div>
                <div class="neural-upload-list" data-file-upload-target="list"></div>
              </div>
            </div>

            <div class="neural-field">
              <div class="neural-field__header">
                <div class="neural-field__icon neural-field__icon--mode">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                  </svg>
                </div>
                <div class="neural-field__label-group">
                  <%= f.label :permission_mode, "Permission Mode", class: "neural-field__label" %>
                  <span class="neural-field__hint">Control Claude's autonomy level</span>
                </div>
              </div>
              <div class="neural-mode-grid">
                <% modes = [
                  ["acceptEdits", "Auto-Accept", "Full autonomy"],
                  ["default", "Default", "Ask permission"]
                ] %>
                <% modes.each do |value, label, hint| %>
                  <label class="neural-mode-option <%= "is-selected" if value == "acceptEdits" %>">
                    <%= f.radio_button :permission_mode, value, checked: value == "acceptEdits" %>
                    <div class="neural-mode-option__content">
                      <span class="neural-mode-option__label"><%= label %></span>
                      <span class="neural-mode-option__hint"><%= hint %></span>
                    </div>
                    <div class="neural-mode-option__indicator"></div>
                  </label>
                <% end %>
              </div>
            </div>
          </div>

          <div class="neural-actions">
            <button type="submit" class="neural-submit">
              <div class="neural-submit__bg"></div>
              <div class="neural-submit__content">
                <svg class="neural-submit__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
                <span>Execute Command</span>
              </div>
              <div class="neural-submit__glow"></div>
            </button>
          </div>
        <% end %>
      </div>
    </main>

    <footer class="neural-footer">
      <div class="neural-footer__item">
        <span class="neural-footer__key">Model</span>
        <span class="neural-footer__value">Claude Sonnet 4.6</span>
      </div>
      <div class="neural-footer__divider"></div>
      <div class="neural-footer__item">
        <span class="neural-footer__key">Engine</span>
        <span class="neural-footer__value">Claude Code CLI</span>
      </div>
      <div class="neural-footer__divider"></div>
      <div class="neural-footer__item">
        <span class="neural-footer__key">Status</span>
        <span class="neural-footer__value neural-footer__value--active">Online</span>
      </div>
    </footer>
  </div>
</div>
